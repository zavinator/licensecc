/**
 * \file
 * This file contains all the properties that are customizable on on a per-project basis eg:
 * 1) api parameter sizes
 * 2)
 *
 * It is safe to place the values that your project need to customize here, since each project get its own copy of this
 * file.
 */

/**
 * \addtogroup api
 * @{
 */

#ifndef BUILD_PROPERTIES_H_
#define BUILD_PROPERTIES_H_

/**
 * This file contains all the properties that are customizable on on a per-project basis eg:
 * 1) api parameter sizes
 *
 * It is safe to place the values that your project need to customize here, since each project get its own
 * copy of this file.
 */
// clang-format off
#define LCC_PROJECT_NAME "@LCC_PROJECT_NAME@"
#define LCC_PROJECT_INT_VERSION \
	(@CMAKE_PROJECT_VERSION_MAJOR@ * 10000 + @CMAKE_PROJECT_VERSION_MINOR@ * 100 + @CMAKE_PROJECT_VERSION_PATCH@)
#define LCC_PROJECT_VERSION "@CMAKE_PROJECT_VERSION@"
// clang-format on

// License retrieval configuration
#ifndef FIND_LICENSE_NEAR_MODULE
#define FIND_LICENSE_NEAR_MODULE true
#endif
#define FIND_LICENSE_WITH_ENV_VAR false

/**
 * License file name extension
 */
#define LCC_LICENSE_FILE_EXTENSION ".lic"
#define LCC_LICENSE_LOCATION_ENV_VAR "LICENSE_LOCATION"
#define LCC_LICENSE_DATA_ENV_VAR "LICENSE_DATA"

// Api structure limits
/**
 * Maximum size of a license file or base64 data
 * Prevent people from replacing the license with a large file and make the software crash.
 */
#define LCC_API_MAX_LICENSE_DATA_LENGTH 1024 * 8

// define api structure sizes

/*
 * size of the buffer to allocate for the pc identifier
 */
#define LCC_API_PC_IDENTIFIER_SIZE ((HW_IDENTIFIER_PROPRIETARY_DATA + 1) * 5 / 3)
#define LCC_API_PROPRIETARY_DATA_SIZE 64
#define LCC_API_AUDIT_EVENT_NUM 5
#define LCC_API_AUDIT_EVENT_PARAM2 255
#define LCC_API_VERSION_LENGTH 15
#define LCC_API_FEATURE_NAME_SIZE 15
#define LCC_API_EXPIRY_DATE_SIZE 10
#define LCC_API_ERROR_BUFFER_SIZE 256

/**
This definition allows to specify a custom expression to verify the magic number passed in by the api.
*/
// clang-format off
#define LCC_VERIFY_MAGIC (lic_info.m_magic == @LCC_PROJECT_MAGIC_NUM@)
// clang-format on

/**
 *
 * Environment variable name that if defined will change the identification strategy used to generate the hardware
 * identifier. If a client has an unstable pc-identifier use this variable to generate one. Valid values are integers
 * defined in `LCC_IDENTIFICATION_STRATEGY` enum.
 */
#define LCC_IDENTIFICATION_STRATEGY_ENV_VAR "IDENTIFICATION_STRATEGY"

/**
 * \enum LCC_API_HW_IDENTIFICATION_STRATEGY
 *
 * This enum list all the possible pc identification strategy. It is to be used as a parameter of ::identify_pc
 *
 * ::STRATEGY_DEFAULT Should be used in most cases.
 */
enum LCC_API_HW_IDENTIFICATION_STRATEGY {
	STRATEGY_NONE = -2,
	/**
	 * \brief Default strategy.
	 *
	 * This strategy first checks the content of the environment variable `IDENTIFICATION_STRATEGY`. If the variable
	 * is defined it will use the strategy specified in there, if not defined it will try to detect which virtual
	 * environment the software is running in.
	 *  - If no virtual environment is detected it will try the strategies defined in ::LCC_BARE_TO_METAL_STRATEGIES
	 *  - If it detects the software is running in a virtual machine it will use ::LCC_VM_STRATEGIES
	 *  - If it detects the software is running in a docker or in an LXC it will use ::LCC_DOCKER_STRATEGIES or
	 * ::LCC_DOCKER_STRATEGIES
	 *  - If it detects the software is running in a virtual machine in the cloud it will use ::LCC_CLOUD_STRATEGIES
	 */
	STRATEGY_DEFAULT = -1,
	/**
	 * \brief Uses mac address to generate hardware id.
	 *
	 * This strategy use the mac address of one of the network adapters to generate the hardware identifier.
	 * Network adapters are scored using their names, trying to avoid vpn adapters and virtual devices.
	 * Mac address should be unique in the subnetwork, so this strategy poses some limitation on the number of licenses
	 * that can be in use in the same subnet.
	 */
	STRATEGY_ETHERNET = 0,
	STRATEGY_IP_ADDRESS = 1,
	STRATEGY_DISK = 2,
	STRATEGY_CPU_MODEL = 3,
	/**
	 * Uses OS-specific identifier to generate hardware id.
	 *
	 * This strategy uses the OS-specific machine identifier (e.g., /etc/machine-id on Linux,
	 * ProductId on Windows) to generate the hardware identifier.
	 */
	STRATEGY_SYSTEM_ID = 4

};

/**
 * @addtogroup strategies
 * @{
 *
 * The following group of settings change the behavior of the underlying strategy selection
 * when LCC_API_HW_IDENTIFICATION_STRATEGY::STRATEGY_DEFAULT is choosen.
 */
/**
 *
 * List the strategies used when no virtual envrionment is detected
 */
#define LCC_BARE_TO_METAL_STRATEGIES {STRATEGY_DISK, STRATEGY_SYSTEM_ID, STRATEGY_CPU_MODEL, STRATEGY_NONE}
/**
 * List the strategies used when the software is executing in a virtual machine
 */
#define LCC_VM_STRATEGIES {STRATEGY_ETHERNET, STRATEGY_SYSTEM_ID, STRATEGY_NONE}
/**
 * List the strategies used when it's detected a VM executed execution in the cloud.
 * CPU_MODEL is not very restrictive. Need to debug with Inspector.
 */
#define LCC_CLOUD_STRATEGIES {STRATEGY_CPU_MODEL, STRATEGY_NONE}

#define LCC_LXC_STRATEGIES {STRATEGY_ETHERNET, STRATEGY_SYSTEM_ID, STRATEGY_CPU_MODEL, STRATEGY_NONE}
#define LCC_DOCKER_STRATEGIES {STRATEGY_CPU_MODEL, STRATEGY_NONE}

/**
 * @}
 */

/**
 * Lenght of the proprietary data contained in the pc identifier.
 * The full lenght of the data is HW_IDENTIFIER_PROPRIETARY_DATA + 1
 *
 * To get the lenght of the pc identifier consider that the data will be encoded
 * in base64 and separated by "-" every 4 digits so the pc
 * identifier will be (HW_IDENTIFIER_PROPRIETARY_DATA + 1)*5/3 - 1
 * (-1 because there is no "-" in the end) bytes long.
 */
#define HW_IDENTIFIER_PROPRIETARY_DATA 8

/**
 * If == 0 do not add default limits to the verifier.
 *
 */
#ifndef LCC_ADD_DEFAULT_LIMITS
#define LCC_ADD_DEFAULT_LIMITS 1
#endif
/**
 * Date verification against an NTP server.
 *
 * Licenses with an expiry date (`valid-to`) or a start date (`valid-from`) can be verified against
 * the time reported by an NTP server, to detect a system clock that has been set in the past to
 * keep using an expired license. Licenses without date limits never access the network.
 *
 * N.B. the simple network time protocol is not authenticated: it protects against a casual clock
 * manipulation, not against an attacker able to intercept or spoof the udp traffic.
 */
/**
 * Host name of the NTP server used to verify the license dates. Consider using a server that is
 * reachable by your customers, or an internal one if the licensed software runs in a closed
 * network. Any host serving the SNTP protocol on port 123 is fine.
 */
#ifndef LCC_NTP_SERVER_NAME
#define LCC_NTP_SERVER_NAME "pool.ntp.org"
#endif
/**
 * How much the network time protocol is trusted when verifying the license dates. The three
 * values below are mutually exclusive, set LCC_NTP_CHECK to one of them:
 *
 * LCC_NTP_CHECK_NO       the NTP server is never queried and no network access is performed, the
 *                    dates are verified against the system clock only (library behavior prior to
 *                    the introduction of this check). Set it on machines without internet access.
 * LCC_NTP_CHECK_OPTIONAL if the NTP server answers, the dates are verified against the server time,
 *                    and the license is rejected with the event TIME_OUT_OF_SYNC when the system
 *                    clock is off by more than LCC_MAX_ALLOWED_OFFSET_SEC. If the server can't be
 *                    reached the system clock is used as a fallback.
 * LCC_NTP_CHECK_REQUIRED as above, but the server must answer: if it can't be reached the license is
 *                    rejected with the event TIME_OUT_OF_SYNC. Safer, but the software will not
 *                    start at all in an offline environment.
 */
#define LCC_NTP_CHECK_NO 0
#define LCC_NTP_CHECK_OPTIONAL 1
#define LCC_NTP_CHECK_REQUIRED 2
#ifndef LCC_NTP_CHECK
#define LCC_NTP_CHECK LCC_NTP_CHECK_OPTIONAL
#endif
/**
 * Maximum allowed difference, in seconds, between the system clock and the NTP server time. A
 * bigger difference is considered clock tampering and the license is rejected with the event
 * TIME_OUT_OF_SYNC. It should be larger than the clock drift you normally observe on your
 * customers' machines, especially if they run virtual machines that are suspended for long
 * periods. It is compared with the absolute value of the difference, so a clock set in the
 * future is rejected too.
 */
#ifndef LCC_MAX_ALLOWED_OFFSET_SEC
#define LCC_MAX_ALLOWED_OFFSET_SEC 3600
#endif

#endif
/**
 * @}
 */
